<?xml version="1.0" encoding="utf-8"?>
<!--
  Topology: VPN-only (Tailscale / WireGuard).

  Cleartext is permitted at the platform level, and refused instead by UrlValidator,
  which is the single gate every configured URL passes through before it is stored.

  Why not enforce it here as well: Android matches hostnames, not address ranges, so a
  config strict enough to block public http also blocks http to a tailnet peer's own
  100.64.0.0/10 address — the address Tailscale shows first, and one that is not
  reachable from the internet at all. Enforcing in the validator lets the app allow
  private, tailnet and loopback hosts by range while still refusing cleartext to any
  public host, which the static config cannot express.

  UrlValidator is the enforcement point. See SECURITY.md, "Network security".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
